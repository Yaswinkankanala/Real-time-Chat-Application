# Server Configuration
PORT=5000
JWT_SECRET=super_secret_jwt_random_key_change_in_production

# Optional: Frontend URL for CORS (if frontend is deployed separately, e.g. Vercel/Netlify)
# CLIENT_URL=https://your-chatsphere-app.vercel.app

# Firebase Configuration for Backend Token Verification
# 1. Project ID (Required for Firebase ID token verification)
FIREBASE_PROJECT_ID=your-firebase-project-id

# 2. Firebase Admin Service Account (Recommended for Production)
# Option A: Paste full Service Account JSON content as a single line
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}
# Option B: Path to downloaded serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Optional: Also provide frontend Firebase credentials here to auto-serve to client
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Optional: Google Gemini API Key for Nova AI Assistant (or leave blank to use intelligent built-in agent)
GEMINI_API_KEY=
